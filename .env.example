# Public DEMO works with no environment file or credentials.
PIGTOGRAM_DATA_MODE=demo

# The protected reader ONLY supports synthetic GitHub API responses.
# "live" is rejected. No repository token is consumed by this version.
PIGTOGRAM_GITHUB_SOURCE=fixture

# Future identity configuration, after approval. Keep commented for DEMO.
# Values belong only in server .env.local / a server secret store, never Git.
# AUTH_URL=http://localhost:3000
# AUTH_SECRET=<random-value-at-least-32-characters>
# AUTH_GITHUB_ID=<dedicated-oauth-app-client-id>
# AUTH_GITHUB_SECRET=<dedicated-oauth-app-client-secret>
# PIGTOGRAM_OWNER_GITHUB_ID=<verified-numeric-github-user-id>
